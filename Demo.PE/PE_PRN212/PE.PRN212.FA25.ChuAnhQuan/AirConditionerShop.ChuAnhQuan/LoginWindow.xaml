<Window x:Class="AirConditionerShop.ChuAnhQuan.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirConditionerShop.ChuAnhQuan"
        mc:Ignorable="d"
        Title="LoginWindow" Height="300" Width="600" FontFamily= "Arial"
FontSize= "14" 
Background= "#FFD4F7D4" 
WindowStartupLocation= "CenterScreen" 
>
    <Grid>
        
        
        <TextBox x:Name="EmailTextBox" HorizontalAlignment="Left" Height="40" Margin="200,24,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="360"/>
        <Label Content="Email" HorizontalAlignment="Left" Height="40" Margin="40,24,0,0" VerticalAlignment="Top" Width="120" Background="White"/>

        <TextBox x:Name="PassTextBox" HorizontalAlignment="Left" Height="40" Margin="200,84,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="360"/>
        <Label Content="Pass" HorizontalAlignment="Left" Height="40" Margin="40,84,0,0" VerticalAlignment="Top" Width="120" Background="White"/>


        <Button x:Name="LoginButton" Content="Login" HorizontalAlignment="Left" Height="40" Margin="100,184,0,0" VerticalAlignment="Top" Width="140" Click="LoginButton_Click"/>
        <Button x:Name="QuitButton" Content="Quit" HorizontalAlignment="Left" Height="40" Margin="340,184,0,0" VerticalAlignment="Top" Width="140" Click="QuitButton_Click"/>

    </Grid>
</Window>
