<Window x:Class="AirConditionerShop.ChuAnhQuan.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirConditionerShop.ChuAnhQuan"
        mc:Ignorable="d"
        Title="DetailWindow" Height="450" Width="800" Background="Blue" WindowStartupLocation="CenterScreen">
    <Grid>


        <Label Content="AirConditioner Id"  Grid.Column="0" VerticalAlignment="Top" Margin="10,4,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="AirConditionerIdTextBox" Grid.Row="0" Margin="160,4,5,400" IsReadOnly="True"/>

        <Label Content="AirConditioner Name"  Grid.Column="0" VerticalAlignment="Top" Margin="10,44,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="AirConditionerNameTextBox" Grid.Row="0" Margin="160,44,5,360" IsReadOnly="True"/>

        <Label Content="Warranty"  Grid.Column="0" VerticalAlignment="Top" Margin="10,84,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="WarrantyTextBox" Grid.Row="0" Margin="160,84,5,320" IsReadOnly="True"/>

        <Label Content="Sound Pressure Level"  Grid.Column="0" VerticalAlignment="Top" Margin="10,124,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="SoundPressureLevelTextBox" Grid.Row="0" Margin="160,124,5,280" IsReadOnly="True"/>

        <Label Content="Feature Function"  Grid.Column="0" VerticalAlignment="Top" Margin="10,164,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="FeatureFunctionTextBox" Grid.Row="0" Margin="160,164,5,240" IsReadOnly="True"/>

        <Label Content="Quantity"  Grid.Column="0" VerticalAlignment="Top" Margin="10,204,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="QuantityTextBox" Grid.Row="0" Margin="160,204,5,200" IsReadOnly="True"/>

        <Label Content="Dollar Price"  Grid.Column="0" VerticalAlignment="Top" Margin="10,244,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <TextBox x:Name="DollarPriceTextBox" Grid.Row="0" Margin="160,244,5,160" IsReadOnly="True"/>

        <Label Content="Supplier"  Grid.Column="0" VerticalAlignment="Top" Margin="10,284,650,0" Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="12" Height="30"/>
        <ComboBox x:Name="SupplierComboBox" Grid.Row="0" Margin="160,284,5,120" IsReadOnly="True"/>




    </Grid>
</Window>
