<Window x:Class="AirConditionerShop.ChuAnhQuan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirConditionerShop.ChuAnhQuan"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="Blue" WindowStartupLocation="CenterScreen">
    <Grid>
        <DataGrid HorizontalAlignment="Left" Height="280" Margin="30,34,0,0" VerticalAlignment="Top" Width="540" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Button x:Name="CreateButton" Content="Create" HorizontalAlignment="Left" Height="45" Margin="595,44,0,0" VerticalAlignment="Top" Width="180" 
            Foreground="Blue" Background="Yellow"
            FontSize="25" FontWeight="ExtraBold" 
            Click="LoginButton_Click"/>
        <Button x:Name="UpdateButton" Content="Update" HorizontalAlignment="Left" Height="45" Margin="595,99,0,0" VerticalAlignment="Top" Width="180" 
            Foreground="Blue" Background="Yellow"
            FontSize="25" FontWeight="ExtraBold" 
            Click="UpdateButton_Click"/>
        <Button x:Name="DeleteButton" Content="Delete" HorizontalAlignment="Left" Height="45" Margin="595,164,0,0" VerticalAlignment="Top" Width="180" 
            Foreground="Blue" Background="Yellow"
            FontSize="25" FontWeight="ExtraBold" 
            Click="DeleteButton_Click"/>
        <Button x:Name="QuitButton" Content="Quit" HorizontalAlignment="Left" Height="45" Margin="595,229,0,0" VerticalAlignment="Top" Width="180" 
            Foreground="Blue" Background="Yellow"
            FontSize="25" FontWeight="ExtraBold" 
            Click="QuitButton_Click"/>
    </Grid>
</Window>
