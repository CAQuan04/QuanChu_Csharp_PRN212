<Window x:Class="AirConditionerShop.ChuAnhQuan.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirConditionerShop.ChuAnhQuan"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800" Background="Blue" WindowStartupLocation="CenterScreen">
    <Grid>

        <Label Content="Email" HorizontalAlignment="Left" Height="45" Margin="80,49,0,0" VerticalAlignment="Top" Width="80"  Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="25" />
        <Label Content="Pass" HorizontalAlignment="Left" Height="50" Margin="80,124,0,0" VerticalAlignment="Top" Width="80"  Background="Yellow" Foreground="Blue" FontWeight="ExtraBold" FontSize="25" />

        <TextBox x:Name="EmailTextBox" HorizontalAlignment="Left" Height="35" Margin="200,59,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="360"/>
        <TextBox x:Name="PassTextBox" HorizontalAlignment="Left" Height="35" Margin="200,134,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="360"/>

        <Button x:Name="LoginButton" Content="Login" HorizontalAlignment="Left" Height="80" Margin="65,254,0,0" VerticalAlignment="Top" Width="260" 
        Foreground="Blue" Background="Yellow"
        FontSize="30" FontWeight="ExtraBold" 
        Click="LoginButton_Click"/>
        <Button x:Name="QuitButton"  Content="Quit" HorizontalAlignment="Left" Height="80" Margin="425,254,0,0" VerticalAlignment="Top" Width="260" 
            Foreground="Blue" Background="Yellow"
            FontSize="30" FontWeight="ExtraBold" 
            Click="QuitButton_Click"/>
    </Grid>
</Window>
